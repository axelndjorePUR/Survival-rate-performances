expression 'DirectQuery à AS – Golden_field_dataset' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Golden%20datasets", "Golden_field_dataset"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 443c2eb6-3597-428e-9733-b9fc2e2abeb5

	annotation PBI_IncludeFutureArtifacts = True

