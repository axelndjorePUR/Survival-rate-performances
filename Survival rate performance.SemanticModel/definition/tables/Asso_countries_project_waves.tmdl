table Asso_countries_project_waves
	lineageTag: 2f48c9f2-e69c-453e-9a74-8475547cb39e
	sourceLineageTag: 2fb64582-6c74-49b1-ae94-5684017934b8

	measure 'trees distributed per ha' =
			
			ROUND(DIVIDE(
				[distributed trees],
				SUM('Dim_parcels'[parcel_area_ha])
			),0)
		lineageTag: baac1c78-7aa6-4d34-a812-595b6b2cccef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Corrélation de m1 survival rate et trees distributed per ha pour country' =
			
			VAR __CORRELATION_TABLE = VALUES('Dim_subprojectwaves'[country])
			VAR __COUNT =
				COUNTX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([m1 static survival rate] * [trees distributed per ha])
				)
			VAR __SUM_X = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([m1 static survival rate]))
			VAR __SUM_Y =
				SUMX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([trees distributed per ha])
				)
			VAR __SUM_XY =
				SUMX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([m1 static survival rate] * [trees distributed per ha] * 1.)
				)
			VAR __SUM_X2 =
				SUMX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([m1 static survival rate] ^ 2)
				)
			VAR __SUM_Y2 =
				SUMX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([trees distributed per ha] ^ 2)
				)
			RETURN
				DIVIDE(
					__COUNT * __SUM_XY - __SUM_X * __SUM_Y * 1.,
					SQRT(
						(__COUNT * __SUM_X2 - __SUM_X ^ 2)
							* (__COUNT * __SUM_Y2 - __SUM_Y ^ 2)
					)
				)
		lineageTag: a139edef-cfb4-4ed6-80b4-577f3edf2a67

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Input-Receiving Producers Groups' =
			
			SWITCH(true(),[input-receiving producers] <= 100, "0-100",[input-receiving producers] > 101 && [input-receiving producers] <= 150, "101-150", [input-receiving producers] > 151 && [input-receiving producers] <= 300, "151-200", "<200")
		lineageTag: a1d392d0-64df-41a4-8cfd-ddb9e5a5f6c0

	measure 'Cumulative Total tree prereg' = ```
			
